enum class ItemType { WEAPON, ARMOR, POTION };

struct Item {
    std::string name;
    ItemType type;
    int value; // Damage for weapons, Defense for armor, Healing for potions
    int goldValue;

    std::string getInfo() const {
        std::string typeStr;
        switch (type) {
            case ItemType::WEAPON: typeStr = "Weapon (+" + std::to_string(value) + " Atk)"; break;
            case ItemType::ARMOR:  typeStr = "Armor (+" + std::to_string(value) + " Def)"; break;
            case ItemType::POTION: typeStr = "Potion (+" + std::to_string(value) + " HP)"; break;
        }
        return name + " [" + typeStr + "] - Value: " + std::to_string(goldValue) + "g";
    }
};

// Base class for all living creatures in the game
class Entity {
protected:
    std::string name;
    int hp;
    int maxHp;
    int attack;
    int defense;
    int level;

public:
    Entity(std::string name, int hp, int attack, int defense, int level = 1)
        : name(name), hp(hp), maxHp(hp), attack(attack), defense(defense), level(level) {}

    virtual ~Entity() = default;

    // Getters and Setters
    std::string getName() const { return name; }
    int getHP() const { return hp; }
    int getMaxHP() const { return maxHp; }
    int getAttack() const { return attack; }
    int getDefense() const { return defense; }
    int getLevel() const { return level; }

    bool isAlive() const { return hp > 0; }

    void takeDamage(int amount) {
        int actualDamage = std::max(1, amount - defense);
        hp = std::max(0, hp - actualDamage);
        std::cout << name << " takes " << actualDamage << " damage! (" << hp << "/" << maxHp << " HP left)\n";
    }

    void heal(int amount) {
        hp = std::min(maxHp, hp + amount);
        std::cout << name << " is healed by " << amount << " HP! (" << hp << "/" << maxHp << " HP)\n";
    }

    virtual void showStats() const {
        std::cout << "--- " << name << " ---\n"
                  << "Level: " << level << "\n"
                  << "HP: " << hp << "/" << maxHp << "\n"
                  << "Attack: " << attack << "\n"
                  << "Defense: " << defense << "\n";
    }
};

// ============================================================================
// MONSTERS
// ============================================================================

class Monster : public Entity {
private:
    int xpReward;
    int goldReward;

public:
    Monster(std::string name, int hp, int attack, int defense, int xp, int gold, int level = 1)
        : Entity(name, hp, attack, defense, level), xpReward(xp), goldReward(gold) {}

    int getXpReward() const { return xpReward; }
    int getGoldReward() const { return goldReward; }

    static std::shared_ptr<Monster> generateRandom(int playerLevel) {
        int lvl = playerLevel + RNG::get(-1, 2);
        if (lvl < 1) lvl = 1;

        std::vector<std::pair<std::string, std::string>> types = {
            {"Goblin", "Scout"}, {"Orc", "Warrior"}, {"Skeleton", "Archer"}, {"Dark Mage", "Acolyte"}, {"Golem", "Guardian"}
        };

        auto selected = types[RNG::get(0, types.size() - 1)];
        std::string finalName = selected.second + " " + selected.first;

        int hp = lvl * 25 + RNG::get(5, 15);
        int atk = lvl * 6 + RNG::get(1, 4);
        int def = lvl * 2 + RNG::get(0, 2);
        int xp = lvl * 20;
        int gold = lvl * 15 + RNG::get(0, 10);

        if (RNG::get(1, 10) == 10) { // Mini-Boss
            finalName = "Elite " + finalName;
            hp *= 1.5;
            atk *= 1.3;
            def += 3;
            xp *= 2;
            gold *= 2.5;
        }

        return std::make_shared<Monster>(finalName, hp, atk, def, xp, gold, lvl);
    }
};

// ============================================================================
// PLAYER CLASS WITH SPECIALIZATIONS
// ============================================================================

class Player : public Entity {
protected:
    int xp;
    int xpToNextLevel;
    int gold;
    int mana;
    int maxMana;
    std::string heroClass;

    std::vector<Item> inventory;
    Item equippedWeapon{"Fists", ItemType::WEAPON, 0, 0};
    Item equippedArmor{"Rags", ItemType::ARMOR, 0, 0};

public:
    Player(std::string name, int hp, int attack, int defense, int mana, std::string heroClass)
        : Entity(name, hp, attack, defense, 1), xp(0), xpToNextLevel(100), gold(50),
          mana(mana), maxMana(mana), heroClass(heroClass) {
        inventory.push_back({"Minor Potion", ItemType::POTION, 30, 10});
    }

    int getMana() const { return mana; }
    int getMaxMana() const { return maxMana; }
    int getGold() const { return gold; }
    int getXp() const { return xp; }
    int getXpToNextLevel() const { return xpToNextLevel; }
    std::string getHeroClass() const { return heroClass; }
    const std::vector<Item>& getInventory() const { return inventory; }

    void addGold(int amount) {
        gold += amount;
        std::cout << "Gained " << amount << " gold! (Total: " << gold << "g)\n";
    }

    void spendGold(int amount) {
        gold = std::max(0, gold - amount);
    }

    void gainXp(int amount) {
        xp += amount;
        std::cout << "Gained " << amount << " XP! (" << xp << "/" << xpToNextLevel << ")\n";
        if (xp >= xpToNextLevel) {
            levelUp();
        }
    }

    void addItem(const Item& item) {
        inventory.push_back(item);
        std::cout << "Added to inventory: " << item.name << "\n";
    }

    void usePotion(size_t index) {
        if (index >= inventory.size() || inventory[index].type != ItemType::POTION) {
            std::cout << "Invalid potion selection!\n";
            return;
        }
        heal(inventory[index].value);
        inventory.erase(inventory.begin() + index);
    }

    void equipItem(size_t index) {
        if (index >= inventory.size()) return;
        Item item = inventory[index];

        if (item.type == ItemType::WEAPON) {
            if (equippedWeapon.name != "Fists") {
                inventory.push_back(equippedWeapon);
            }
            equippedWeapon = item;
            attack = attack + item.value;
            std::cout << "Equipped Weapon: " << item.name << " (Attack increased by " << item.value << ")\n";
            inventory.erase(inventory.begin() + index);
        } else if (item.type == ItemType::ARMOR) {
            if (equippedArmor.name != "Rags") {
                inventory.push_back(equippedArmor);
            }
            equippedArmor = item;
            defense = defense + item.value;
            std::cout << "Equipped Armor: " << item.name << " (Defense increased by " << item.value << ")\n";
            inventory.erase(inventory.begin() + index);
        } else {
            std::cout << "Cannot equip a potion!\n";
        }
    }

    void showInventory() {
        std::cout << "\n================ INVENTORY ================\n";
        std::cout << "Equipped Weapon: " << equippedWeapon.name << " (+" << equippedWeapon.value << " Atk)\n";
        std::cout << "Equipped Armor:  " << equippedArmor.name << " (+" << equippedArmor.value << " Def)\n";
        std::cout << "-------------------------------------------\n";
        if (inventory.empty()) {
            std::cout << "Your bag is empty.\n";
        } else {
            for (size_t i = 0; i < inventory.size(); ++i) {
                std::cout << "[" << i + 1 << "] " << inventory[i].getInfo() << "\n";
            }
        }
        std::cout << "===========================================\n";
    }

    virtual void levelUp() {
        level++;
        xp -= xpToNextLevel;
        xpToNextLevel = static_cast<int>(xpToNextLevel * 1.5);
        maxHp += 15;
        hp = maxHp;
        attack += 3;
        defense += 1;
        maxMana += 5;
        mana = maxMana;

        std::cout << "\n===========================================\n"
                  << "🎉 LEVEL UP! You reached Level " << level << "! 🎉\n"
                  << "HP, Mana, Attack, and Defense increased!\n"
                  << "===========================================\n";
        pressEnterToContinue();
    }

    virtual void showStats() const override {
        Entity::showStats();
        std::cout << "Class: " << heroClass << "\n"
                  << "Mana: " << mana << "/" << maxMana << "\n"
                  << "Gold: " << gold << "g\n"
                  << "XP: " << xp << "/" << xpToNextLevel << "\n"
                  << "---------------------\n";
    }

    virtual std::string getSpecialAbilityName() const = 0;
    virtual int useSpecialAbility() = 0;

    // Save state string formatting (comma-separated for simple saving)
    std::string serialize() const {
        std::stringstream ss;
        ss << name << "," << hp << "," << maxHp << "," << attack << "," << defense << ","
           << level << "," << xp << "," << xpToNextLevel << "," << gold << "," << mana << "," 
           << maxMana << "," << heroClass << "," << equippedWeapon.name << "," 
           << equippedWeapon.value << "," << equippedWeapon.goldValue << "," 
           << equippedArmor.name << "," << equippedArmor.value << "," << equippedArmor.goldValue;
        return ss.str();
    }
};

// Warrior Specialization
class Warrior : public Player {
public:
    Warrior(std::string name) : Player(name, 120, 15, 6, 10, "Warrior") {}

    std::string getSpecialAbilityName() const override {
        return "Shield Slam (Cost: 5 Mana, Deals Atk * 1.5 damage, Ignores Enemy Def)";
    }

    int useSpecialAbility() override {
        if (mana >= 5) {
            mana -= 5;
            std::cout << getName() << " executes Shield Slam!\n";
            return static_cast<int>(attack * 1.5);
        }
        std::cout << "Not enough mana!\n";
        return -1;
    }
};

// Mage Specialization
class Mage : public Player {
public:
    Mage(std::string name) : Player(name, 80, 22, 2, 40, "Mage") {}

    std::string getSpecialAbilityName() const override {
        return "Fireball (Cost: 10 Mana, Deals Atk * 2.0 damage)";
    }

    int useSpecialAbility() override {
        if (mana >= 10) {
            mana -= 10;
            std::cout << getName() << " casts Fireball!\n";
            return attack * 2;
        }
        std::cout << "Not enough mana!\n";
        return -1;
    }
};

// Rogue Specialization
class Rogue : public Player {
public:
    Rogue(std::string name) : Player(name, 95, 18, 4, 15, "Rogue") {}

    std::string getSpecialAbilityName() const override {
        return "Assassinate (Cost: 8 Mana, Evasive strike, 30% chance for Atk * 3.0)";
    }

    int useSpecialAbility() override {
        if (mana >= 8) {
            mana -= 8;
            std::cout << getName() << " strikes from the shadows!\n";
            if (RNG::get(1, 10) <= 3) {
                std::cout << "✨ CRITICAL BLOW! ✨\n";
                return attack * 3;
            }
            return static_cast<int>(attack * 1.2);
        }
        std::cout << "Not enough mana!\n";
        return -1;
    }
};

