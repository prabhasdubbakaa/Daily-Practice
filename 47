enum class RoomType { START, EMPTY, MONSTER, CHEST, MERCHANT, SHRINE, BOSS };

struct Room {
    RoomType type;
    bool visited = false;
    std::shared_ptr<Monster> roomMonster = nullptr;
    bool eventCleared = false;

    std::string getSymbol() const {
        if (!visited) return " ? ";
        switch (type) {
            case RoomType::START:    return " S ";
            case RoomType::EMPTY:    return " . ";
            case RoomType::MONSTER:  return eventCleared ? " . " : " M ";
            case RoomType::CHEST:    return eventCleared ? " . " : " C ";
            case RoomType::MERCHANT: return " $ ";
            case RoomType::SHRINE:   return eventCleared ? " . " : " H ";
            case RoomType::BOSS:     return eventCleared ? " . " : " B ";
        }
        return " ? ";
    }
};

class DungeonMap {
private:
    std::vector<std::vector<Room>> grid;
    int playerX;
    int playerY;

public:
    DungeonMap() {
        grid.resize(MAP_HEIGHT, std::vector<Room>(MAP_WIDTH));
        playerX = 0;
        playerY = MAP_HEIGHT - 1; // Start bottom-left
        generateDungeon();
    }

    void generateDungeon() {
        // Initialize all as empty
        for (int y = 0; y < MAP_HEIGHT; ++y) {
            for (int x = 0; x < MAP_WIDTH; ++x) {
                grid[y][x] = Room{RoomType::EMPTY, false, nullptr, false};
            }
        }

        // Set Starting position
        grid[playerY][playerX].type = RoomType::START;
        grid[playerY][playerX].visited = true;

        // Set Boss position (top-right)
        grid[0][MAP_WIDTH - 1].type = RoomType::BOSS;

        // Populate rest of dungeon randomly
        std::vector<RoomType> distribution = {
            RoomType::MONSTER, RoomType::MONSTER, RoomType::MONSTER,
            RoomType::CHEST, RoomType::CHEST,
            RoomType::MERCHANT, RoomType::SHRINE,
            RoomType::EMPTY, RoomType::EMPTY
        };

        for (int y = 0; y < MAP_HEIGHT; ++y) {
            for (int x = 0; x < MAP_WIDTH; ++x) {
                if ((x == playerX && y == playerY) || (x == MAP_WIDTH - 1 && y == 0)) {
                    continue;
                }
                RoomType selectedType = distribution[RNG::get(0, distribution.size() - 1)];
                grid[y][x].type = selectedType;
            }
        }
    }

    int getPlayerX() const { return playerX; }
    int getPlayerY() const { return playerY; }
    Room& getCurrentRoom() { return grid[playerY][playerX]; }

    bool move(char direction) {
        int nextX = playerX;
        int nextY = playerY;

        switch (std::tolower(direction)) {
            case 'w': nextY--; break; // North
            case 's': nextY++; break; // South
            case 'a': nextX--; break; // West
            case 'd': nextX++; break; // East
            default: return false;
        }

        if (nextX >= 0 && nextX < MAP_WIDTH && nextY >= 0 && nextY < MAP_HEIGHT) {
            playerX = nextX;
            playerY = nextY;
            grid[playerY][playerX].visited = true;
            return true;
        }
        return false;
    }

    void draw() const {
        std::cout << "\n------------ DUNGEON MAP ------------\n";
        for (int y = 0; y < MAP_HEIGHT; ++y) {
            std::cout << "  ";
            for (int x = 0; x < MAP_WIDTH; ++x) {
                if (x == playerX && y == playerY) {
                    std::cout << "[P]"; // Player Current Position
                } else {
                    std::cout << grid[y][x].getSymbol();
                }
            }
            std::cout << "\n";
        }
        std::cout << "-------------------------------------\n";
        std::cout << "Legend: [P]=Player, S=Start, M=Monster, C=Chest, $=Merchant, H=Shrine, B=Boss, .=Cleared/Empty\n\n";
    }
};

// ============================================================================
// GAME ENGINE / SYSTEM FLOW
// ============================================================================

class Game {
private:
    std::shared_ptr<Player> player;
    DungeonMap dungeon;
    bool isRunning;

public:
    Game() : isRunning(true) {}

    void run() {
        showMainMenu();
        if (!player) return;

        while (isRunning && player->isAlive()) {
            clearScreen();
            player->showStats();
            dungeon.draw();
            handleMovement();
        }

        if (!player->isAlive()) {
            std::cout << "\n💀 GAME OVER! You perished in the dark depth of the dungeon... 💀\n";
        }
    }

private:
    void showMainMenu() {
        while (true) {
            clearScreen();
            std::cout << "=================================================\n"
                      << "       ⚔️  DARKEST DESCENT: RPG ⚔️                 \n"
                      << "=================================================\n"
                      << " [1] Start New Adventure\n"
                      << " [2] Load Existing Adventure\n"
                      << " [3] Help & Credits\n"
                      << " [4] Exit Game\n"
                      << "=================================================\n"
                      << "Choose option: ";
            
            std::string choice;
            std::getline(std::cin, choice);

            if (choice == "1") {
                createNewCharacter();
                break;
            } else if (choice == "2") {
                if (loadGame()) {
                    break;
                }
            } else if (choice == "3") {
                showHelp();
            } else if (choice == "4") {
                isRunning = false;
                std::cout << "Goodbye, adventurer!\n";
                break;
            }
        }
    }

    void createNewCharacter() {
        clearScreen();
        std::cout << "Enter your hero's name: ";
        std::string name;
        std::getline(std::cin, name);
        if (name.empty()) name = "Unnamed Hero";

        while (true) {
            clearScreen();
            std::cout << "Select Class for " << name << ":\n"
                      << " [1] Warrior - Bulky, defensive, uses Shield Slam\n"
                      << " [2] Mage    - Fragile, glass-cannon, unleashes Fireballs\n"
                      << " [3] Rogue   - Agile, high crit rate, shadows Assassinate\n"
                      << "Select choice: ";
            
            std::string choice;
            std::getline(std::cin, choice);

            if (choice == "1") {
                player = std::make_shared<Warrior>(name);
                break;
            } else if (choice == "2") {
                player = std::make_shared<Mage>(name);
                break;
            } else if (choice == "3") {
                player = std::make_shared<Rogue>(name);
                break;
            }
        }

        std::cout << "\nCharacter created successfully! Starting descent...\n";
        delay(1500);
    }

    void showHelp() {
        clearScreen();
        std::cout << "=================== GAME MANUAL ===================\n"
                  << "Navigate the 5x5 grid using standard WASD keys:\n"
                  << "  W: Up (North), S: Down (South)\n"
                  << "  A: Left (West), D: Right (East)\n\n"
                  << "Fight monsters to level up, gain stats, and collect gold.\n"
                  << "Locate chests to find powerful equipment (weapons/armor).\n"
                  << "Visit the merchant to buy healing potions or sell surplus.\n"
                  << "Unleash powerful magic using your Class Special Ability.\n"
                  << "Finally, navigate to the Boss (B) in the top-right corner\n"
                  << "and defeat the Dungeon Guardian to escape!\n"
                  << "===================================================\n"
                  << "Developers: Antigravity AI | Version: 1.0.0\n";
        pressEnterToContinue();
    }

    void handleMovement() {
        std::cout << "Actions: [WASD] Move | [I] Inventory/Equip | [V] Save Game | [Q] Quit\n";
        std::cout << "Choose action: ";
        std::string actionStr;
        std::getline(std::cin, actionStr);
        if (actionStr.empty()) return;

        char action = std::tolower(actionStr[0]);

        if (action == 'w' || action == 'a' || action == 's' || action == 'd') {
            if (dungeon.move(action)) {
                processRoomEvent();
            } else {
                std::cout << "Ouch! You hit a wall.\n";
                delay(800);
            }
        } else if (action == 'i') {
            manageInventory();
        } else if (action == 'v') {
            saveGame();
        } else if (action == 'q') {
            isRunning = false;
        }
    }

    void processRoomEvent() {
        Room& room = dungeon.getCurrentRoom();
        if (room.eventCleared) {
            std::cout << "The room is quiet. There is nothing here.\n";
            delay(1000);
            return;
        }

        clearScreen();
        switch (room.type) {
            case RoomType::START:
                std::cout << "You are back in the starting chamber. The path up is sealed.\n";
                pressEnterToContinue();
                break;
            case RoomType::EMPTY:
                std::cout << "You step into an empty, damp stone chamber. Water drops echo.\n";
                room.eventCleared = true;
                pressEnterToContinue();
                break;
            case RoomType::MONSTER:
                std::cout << "⚔️ An enemy leaps from the shadows! ⚔️\n";
                room.roomMonster = Monster::generateRandom(player->getLevel());
                delay(1000);
                executeCombat(room.roomMonster);
                if (player->isAlive()) {
                    room.eventCleared = true;
                }
                break;
            case RoomType::CHEST:
                openChest();
                room.eventCleared = true;
                break;
            case RoomType::MERCHANT:
                visitMerchant();
                break;
            case RoomType::SHRINE:
                interactShrine();
                room.eventCleared = true;
                break;
            case RoomType::BOSS:
                std::cout << "🔥 THE CHAMBER OF THE DUNGEON GUARDIAN! 🔥\n";
                std::cout << "The ground shakes as an enormous Dragon rises from the gold piles!\n";
                room.roomMonster = std::make_shared<Monster>("Dungeon Guardian Dragon", 250, 45, 12, 1000, 500, 10);
                delay(2000);
                executeCombat(room.roomMonster);
                if (player->isAlive()) {
                    room.eventCleared = true;
                    std::cout << "\n👑 VICTORY! You have slain the Dungeon Guardian and escaped the depths! 👑\n";
                    std::cout << "You win the game! Congratulations!\n";
                    isRunning = false;
                    pressEnterToContinue();
                }
                break;
        }
    }

    void executeCombat(std::shared_ptr<Monster> monster) {
        while (player->isAlive() && monster->isAlive()) {
            clearScreen();
            std::cout << "================= COMBAT ZONE =================\n";
            std::cout << std::left << std::setw(25) << ("Player: " + player->getName()) 
                      << " vs " << ("Monster: " + monster->getName()) << "\n";
            std::cout << "HP: " << player->getHP() << "/" << player->getMaxHP() 
                      << "                 HP: " << monster->getHP() << "/" << monster->getMaxHP() << "\n";
            std::cout << "Mana: " << player->getMana() << "/" << player->getMaxMana() << "\n";
            std::cout << "===============================================\n"
                      << " [1] Attack (Basic)\n"
                      << " [2] Special Ability: " << player->getSpecialAbilityName() << "\n"
                      << " [3] Drink Healing Potion\n"
                      << " [4] Try to Flee\n"
                      << "===============================================\n"
                      << "Choose option: ";
            
            std::string choice;
            std::getline(std::cin, choice);

            int playerDmg = 0;
            bool turnEnded = false;

            if (choice == "1") {
                playerDmg = player->getAttack() + RNG::get(-2, 3);
                std::cout << "\nYou swing your weapon at " << monster->getName() << "!\n";
                monster->takeDamage(playerDmg);
                turnEnded = true;
            } else if (choice == "2") {
                playerDmg = player->useSpecialAbility();
                if (playerDmg != -1) {
                    monster->takeDamage(playerDmg);
                    turnEnded = true;
                } else {
                    pressEnterToContinue();
                }
            } else if (choice == "3") {
                // Find potion
                auto& inv = player->getInventory();
                int idx = -1;
                for (size_t i = 0; i < inv.size(); ++i) {
                    if (inv[i].type == ItemType::POTION) {
                        idx = i;
                        break;
                    }
                }
                if (idx != -1) {
                    player->usePotion(idx);
                    turnEnded = true;
                } else {
                    std::cout << "\nYou have no potions in your inventory!\n";
                    pressEnterToContinue();
                }
            } else if (choice == "4") {
                if (RNG::get(1, 10) <= 4) {
                    std::cout << "\nYou successfully fled the battle!\n";
                    pressEnterToContinue();
                    // Move player back to start just to relocate safety
                    break;
                } else {
                    std::cout << "\nFailed to flee! The beast blocks the way!\n";
                    turnEnded = true;
                }
            }

            if (turnEnded) {
                delay(1200);
                if (monster->isAlive()) {
