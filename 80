import java.util.*;

class Solution {
    class Group {
        int start, length;

        Group(int start, int length) {
            this.start = start;
            this.length = length;
        }
    }

    public List<Integer> maxActiveSectionsAfterTrade(String s, int[][] queries) {
        final int n = s.length();
        List<Group> zeroGroups = new ArrayList<>();
        int[] zeroGroupIndex = new int[n];
        Arrays.fill(zeroGroupIndex, -1);

        for (int i = 0; i < n; i++) {
            if (s.charAt(i) == '0') {
                if (i > 0 && s.charAt(i - 1) == '0') {
                    zeroGroups.get(zeroGroups.size() - 1).length++;
                } else {
                    zeroGroups.add(new Group(i, 1));
                }
            }
            zeroGroupIndex[i] = zeroGroups.size() - 1;
        }

        int m = zeroGroups.size();
        int K = 32 - Integer.numberOfLeadingZeros(Math.max(1, m));
        int[][] st = new int[K][Math.max(1, m)];

        for (int i = 0; i < m; i++) {
            st[0][i] = zeroGroups.get(i).length;
        }

        for (int i = 1; i < K; i++) {
            for (int j = 0; j + (1 << i) <= m; j++) {
                st[i][j] = Math.max(st[i - 1][j],
                                    st[i - 1][j + (1 << (i - 1))]);
            }
        }

        int[] prefOnes = new int[n + 1];
        for (int i = 0; i < n; i++) {
            prefOnes[i + 1] = prefOnes[i] + (s.charAt(i) == '1' ? 1 : 0);
        }

        List<Integer> ans = new ArrayList<>();

        for (int q = 0; q < queries.length; q++) {
            int l = queries[q][0];
            int r = queries[q][1];

            int ones = prefOnes[r + 1] - prefOnes[l];

            int zgL = zeroGroupIndex[l];
            int zgR = zeroGroupIndex[r];

            if (zgL == -1 || zgR == -1 || zgL >= zgR) {
                ans.add(ones);
                continue;
            }

            int left = (s.charAt(l) == '1') ? 0 : (l - zeroGroups.get(zgL).start + 1);
            int right = (s.charAt(r) == '1') ? 0 : (r - zeroGroups.get(zgR).start);

            int startAdj = zgL + 1;
            int endAdj = (s.charAt(r) == '1') ? zgR : zgR - 1;

            int activeSections = ones;

            if (s.charAt(l) == '0' && s.charAt(r) == '0' && zgL + 1 == zgR) {
                activeSections = Math.max(activeSections, ones + left + right);
            } else if (startAdj <= endAdj) {
                int bit = 31 - Integer.numberOfLeadingZeros(endAdj - startAdj + 1);
                int maxVal = Math.max(
                        st[bit][startAdj],
                        st[bit][endAdj - (1 << bit) + 1]
                );
                activeSections = Math.max(activeSections, ones + maxVal);
            }

            if (s.charAt(l) == '0'
                    && zgL + 1 <= (s.charAt(r) == '1' ? zgR : zgR - 1)) {
                activeSections = Math.max(
                        activeSections,
                        ones + left + zeroGroups.get(zgL + 1).length
                );
            }

            if (s.charAt(r) == '0' && zgL < zgR - 1) {
                activeSections = Math.max(
                        activeSections,
                        ones + right + zeroGroups.get(zgR - 1).length
                );
            }

            ans.add(activeSections);
        }

        return ans;
    }
}
