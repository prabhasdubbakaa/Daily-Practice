class Solution {
public:
    vector<vector<int>> ans;
    vector<int> cur;

    void dfs(int start, int k, int target) {
        if (k == 0 && target == 0) {
            ans.push_back(cur);
            return;
        }
        if (k == 0 || target <= 0) return;

        for (int i = start; i <= 9; i++) {
            cur.push_back(i);
            dfs(i + 1, k - 1, target - i);
            cur.pop_back();
        }
    }

    vector<vector<int>> combinationSum3(int k, int n) {
        dfs(1, k, n);
        return ans;
    }
};
