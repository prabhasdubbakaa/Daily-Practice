class Solution {
public:
    int countCompleteComponents(int n, vector<vector<int>>& edges) {
        vector<vector<int>> adj(n);
        for (auto &e : edges) {
            adj[e[0]].push_back(e[1]);
            adj[e[1]].push_back(e[0]);
        }

        vector<int> vis(n, 0);

        function<void(int, vector<int>&)> dfs = [&](int u, vector<int>& comp) {
            vis[u] = 1;
            comp.push_back(u);
            for (int v : adj[u]) {
                if (!vis[v]) dfs(v, comp);
            }
        };

        int ans = 0;

        for (int i = 0; i < n; i++) {
            if (!vis[i]) {
                vector<int> comp;
                dfs(i, comp);

                int sz = comp.size();
                bool ok = true;

                for (int v : comp) {
                    if ((int)adj[v].size() != sz - 1) {
                        ok = false;
                        break;
                    }
                }

                if (ok) ans++;
            }
        }

        return ans;
    }
};
