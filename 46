function pathExistenceQueries(
    n: number,
    nums: number[],
    maxDiff: number,
    queries: number[][]
): boolean[] {
    const comp = new Array<number>(n);
    let id = 0;
    comp[0] = 0;

    for (let i = 1; i < n; i++) {
        if (nums[i] - nums[i - 1] > maxDiff) id++;
        comp[i] = id;
    }

    const ans: boolean[] = [];
    for (const [u, v] of queries) {
        ans.push(comp[u] === comp[v]);
    }

    return ans;
}
